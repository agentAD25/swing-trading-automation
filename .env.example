# Local development only. DRY_RUN is the sole accepted runtime mode.
SWINGTRADE_MODE=DRY_RUN
SWINGTRADE_ENVIRONMENT=local
SWINGTRADE_BUILD_ID=development
SWINGTRADE_DATABASE_URL=postgresql+psycopg://swingtrade:swingtrade@localhost:5432/swingtrade

# Broker endpoints, accounts, credentials, OAuth, SIM, and LIVE are intentionally absent.
#
# P2-0 documentation-only names for future environment-specific secret-store
# references (not values): SWINGTRADE_DEV_DATABASE_URL_REF,
# SWINGTRADE_TEST_DATABASE_URL_REF, SWINGTRADE_SIM_DATABASE_URL_REF.
# Do not add those variables here. Do not put URLs, passwords, or hosts in
# this file under those names. SWINGTRADE_LIVE_DATABASE_URL_REF must remain
# absent. Local DRY_RUN continues to use SWINGTRADE_DATABASE_URL above.
